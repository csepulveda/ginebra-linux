#!/bin/sh
# neofetch - system info with Ginebra's face, for Ginebra Linux (BusyBox ash + awk only)

[ -f /etc/ginebra.conf ] && . /etc/ginebra.conf

# --- info ---------------------------------------------------------------

HOST=$(hostname)
KERNEL=$(uname -r)
ARCH=$(uname -m)

UPTIME=$(awk '{s=int($1); d=int(s/86400); h=int(s%86400/3600); m=int(s%3600/60);
    if (d) printf "%d dias, ", d; if (h) printf "%dh ", h; printf "%dm", m}' /proc/uptime)

CPU=$(awk -F': ' '/^model name/ {m=$2} /^cpu MHz/ {f=$2} END {
    gsub(/  +/, " ", m); if (m == "") m = "i486";
    if (f != "") printf "%s @ %d MHz", m, f + 0.5; else print m}' /proc/cpuinfo)

# GPU: PCI display class (0x03xx), named by vendor
GPU=""
for d in /sys/bus/pci/devices/*; do
    [ -f "$d/class" ] || continue
    case "$(cat $d/class)" in 0x03*) ;; *) continue ;; esac
    v=$(cat $d/vendor); id=$(cat $d/device)
    case "$v" in
        0x10de) n="NVIDIA" ;;     0x1002) n="ATI" ;;      0x8086) n="Intel" ;;
        0x5333) n="S3" ;;         0x102b) n="Matrox" ;;   0x121a) n="3dfx" ;;
        0x1013) n="Cirrus Logic" ;; 0x1023) n="Trident" ;; 0x1039) n="SiS" ;;
        0x1234) n="QEMU VGA" ;;   0x15ad) n="VMware SVGA" ;; *) n="VGA" ;;
    esac
    GPU="$n [${v#0x}:${id#0x}]"
    break
done

if [ -r /sys/class/graphics/fb0/virtual_size ]; then
    RES="$(awk -F, '{print $1 "x" $2}' /sys/class/graphics/fb0/virtual_size)"
    [ -r /sys/class/graphics/fb0/bits_per_pixel ] && RES="$RES ($(cat /sys/class/graphics/fb0/bits_per_pixel) bits, fb0)"
else
    RES="modo texto"
fi

MEM=$(awk '/^MemTotal/ {t=$2} /^MemAvailable/ {a=$2} END {printf "%dMB / %dMB", (t-a)/1024, t/1024}' /proc/meminfo)
# / is ramfs (kernel without SHMEM): df reports 0, so add up the files instead
DISK=$(du -sk /bin /sbin /etc /lib /usr /home /root /tmp /var /opt 2>/dev/null |
    awk '{k += $1} END {printf "%.1fMB en RAM", k/1024}')

IFACE=${NET_IFACE:-eth0}
IP=$(ifconfig "$IFACE" 2>/dev/null | awk '/inet addr/ {sub("addr:", "", $2); print $2}')
NET="${IP:-sin red}"
[ -n "$IP" ] && NET="$NET ($IFACE)"

SH_NAME=${SHELL##*/}
PROCS=$(ls -d /proc/[0-9]* 2>/dev/null | wc -l)
BINS=$(ls /bin /sbin /usr/bin /usr/sbin 2>/dev/null | grep -v -e '^/' -e '^$' | wc -l)

# --- output -------------------------------------------------------------

E=$(printf '\033')
C="${E}[1;33m"      # logo: yellow
L="${E}[1;36m"      # labels: cyan
R="${E}[0m"

info() { [ -n "$2" ] && echo "${L}$1${R}: $2"; }

{
    echo "${L}root${R}@${L}$HOST${R}"
    echo "-------------"
    info "OS" "Ginebra Linux $ARCH"
    info "Kernel" "$KERNEL"
    info "Uptime" "$UPTIME"
    info "Programas" "$BINS"
    info "Shell" "$SH_NAME"
    info "Resolucion" "$RES"
    info "Terminal" "${TERM:-linux}"
    info "CPU" "$CPU"
    info "GPU" "$GPU"
    info "Memoria" "$MEM"
    info "Disco" "$DISK"
    info "Red" "$NET"
    info "Procesos" "$PROCS"
    echo ""
    echo "${E}[40m   ${E}[41m   ${E}[42m   ${E}[43m   ${E}[44m   ${E}[45m   ${E}[46m   ${E}[47m   ${R}"
    echo "${E}[100m   ${E}[101m   ${E}[102m   ${E}[103m   ${E}[104m   ${E}[105m   ${E}[106m   ${E}[107m   ${R}"
} > /tmp/.neofetch.$$

# Ginebra's face (same as /welcome), info on the right
awk -v c="$C" -v r="$R" '
NR == FNR { info[FNR] = $0; n = FNR; next }
{ logo[FNR] = $0; m = FNR }
END {
    rows = (n > m) ? n : m
    for (i = 1; i <= rows; i++)
        printf "%s%-26s%s%s\n", c, logo[i], r, info[i]
}' /tmp/.neofetch.$$ - << 'LOGO'

     /\_____/\
    /  o   o  \
   ( ==  ^  == )
    )         (
   (           )
  ( (  )   (  ) )
 (__(__)___(__)__)

      ~ meow ~
LOGO

rm -f /tmp/.neofetch.$$
